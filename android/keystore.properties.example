# Copy this file to android/keystore.properties and fill it only on your computer.
# Never commit android/keystore.properties or the .jks keystore.
MYAPP_UPLOAD_KEY_ALIAS=your-key-alias
MYAPP_UPLOAD_STORE_FILE=path/to/your-upload-key.jks
MYAPP_UPLOAD_STORE_PASSWORD=your-store-password
MYAPP_UPLOAD_KEY_PASSWORD=your-key-password