# Backend Community Analytics - Environment Variables Example

# Stripe / checkout
STRIPE_SECRET_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
GATEWAY_URL=http://localhost:3015
CHECKOUT_SUCCESS_URL=http://localhost:3015/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3015/checkout/cancel
WADATRIP_FEE_PCT=15
ALLOW_NO_CONNECT_CHECKOUT=true

# Travelpayouts (flights)
TRAVELPAYOUTS_TOKEN=
AFFILIATE_ID_TP=

# Amadeus (flights)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AFFILIATE_ID_AMA=

# Simulation mode: use stub offers even if keys exist (true/false)
SIMULATE_FLIGHTS=true

# Firestore (optional, if you use a specific project)
# FIRESTORE_PROJECT_ID=
